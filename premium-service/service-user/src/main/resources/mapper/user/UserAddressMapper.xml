<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="premium.user.mapper.UserAddressMapper">

    <select id="findUserAddressList" resultType="premium.model.entity.user.UserAddress">
        select *
        from user_address
        where user_id=#{userId} and is_deleted=0
    </select>

    <select id="getUserAddressById" resultType="premium.model.entity.user.UserAddress">
        select *
        from user_address
        where id=#{addressId} and is_deleted=0
    </select>

</mapper>